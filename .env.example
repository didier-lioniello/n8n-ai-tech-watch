# Optional. When unset, the workflow skips the LLM node and still
# writes a source-only digest flagged for human review.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional overrides
LOOKBACK_HOURS=48
DIGEST_PATH=/tmp/ai-tech-watch-digest.md
ERROR_DIGEST_PATH=/tmp/ai-tech-watch-error.md

# Keep this false unless Slack, Gmail and Sheets credentials are set in n8n.
ENABLE_NOTIFICATIONS=false
